{
  "name": "resolv",
  "version": "3.0.0",
  "description": "Real-time booking and reservation system powered by Go, Chi, PostgreSQL, Redis, and WebSockets",
  "scripts": {
    "backend:dev": "cd backend && go run ./cmd/server",
    "backend:seed": "cd backend && go run ./cmd/seed",
    "backend:test": "cd backend && go test -v ./...",
    "backend:build": "cd backend && go build -o bin/server ./cmd/server",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "rest",
    "booking",
    "reservation",
    "real-time",
    "redis",
    "websockets",
    "go",
    "golang"
  ],
  "author": "Nicolas Lumbert",
  "license": "MIT"
}
